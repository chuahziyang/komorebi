{
  "$schema": "https://raw.githubusercontent.com/LGUG2Z/komorebi/v0.1.25/schema.json",
  "app_specific_configuration_path": "C:\\komorebi\\applications.json",
  "window_hiding_behaviour": "Cloak",
  "cross_monitor_move_behaviour": "Insert",
  "default_workspace_padding": 0,
  "default_container_padding": 0,
  "border": true,
  "border_width": 3,
  "border_offset": -1,
  "border_colours": {
    "single": "#82e2ff",
    "stack": "#a277ff",
    "monocle": "#f694ff",
    "floating": "#ffca85",
    "unfocused": "#15141b"
  },
  "display_index_preferences": {
    "0": "SAM0DD4-5&2f3cc79a&0&UID4353",
    "1": "LHCFFFF-5&2f3cc79a&0&UID4352"
  },
  "layered_applications": [
    { "kind": "Exe", "id": "claude.exe", "matching_strategy": "Equals" }
  ],
  "manage_rules": [
    [
      { "kind": "Exe", "id": "claude.exe", "matching_strategy": "Equals" },
      { "kind": "Class", "id": "Chrome_WidgetWin_1", "matching_strategy": "Equals" }
    ]
  ],
  "ignore_rules": [
    { "kind": "Class", "id": "MSCTFIME UI", "matching_strategy": "Equals" }
  ],
  "stackbar": {
    "mode": "Never",
  },
  "monitors": [
    {
      "workspaces": [
        {
          "name": "I",
          "layout": "VerticalStack"
        },
        {
          "name": "II",
          "layout": "VerticalStack"
        },
        {
          "name": "III",
          "layout": "VerticalStack"
        },
        {
          "name": "IV",
          "layout": "VerticalStack"
        },
        {
          "name": "V",
          "layout": "VerticalStack"
        },
        {
          "name": "VI",
          "layout": "VerticalStack"
        },
        {
          "name": "VII",
          "layout": "VerticalStack"
        },
        {
          "name": "VIII",
          "layout": "VerticalStack"
        }
      ]
    }
  ]
}
